# Optional key for user-entered custom Roboflow models; local models need no key.
# Get your publishable key at https://roboflow.com
VITE_ROBOFLOW_API_KEY=your_roboflow_publishable_key_here

# Notion project tracking (agent/terminal only; never use a VITE_ prefix)
# Use an existing integration token with access to the shared tracker.
NOTION_API_KEY=your_notion_integration_token_here
NOTION_API_VERSION=2026-03-11
